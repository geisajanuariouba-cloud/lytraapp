# ==========================================================================
# Lytra — variáveis de ambiente (exemplo, SEM valores reais)
# Copie para `.env` e preencha. NUNCA commitar o `.env` com valores reais.
# ==========================================================================

# --------------------------------------------------------------------------
# Supabase — CLIENTE (público; embutido no bundle do navegador via Vite)
# Prefixo VITE_ é obrigatório para chegar ao cliente.
# Use a chave anon/publishable (pública por design). NUNCA a service role aqui.
# --------------------------------------------------------------------------
VITE_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publishable"

# --------------------------------------------------------------------------
# Supabase — SERVIDOR (server functions, middleware, webhook)
# Sem prefixo VITE_ → nunca vão para o cliente.
# --------------------------------------------------------------------------
SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
# Mesma chave anon/publishable acima (usada no middleware de auth do servidor).
# Observação: o código usa SUPABASE_PUBLISHABLE_KEY (não "SUPABASE_ANON_KEY").
SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publishable"
# SECRETA — concede acesso total ignorando RLS. NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-SECRETA"

# --------------------------------------------------------------------------
# IA — Google Gemini (SERVIDOR; usado apenas em server functions)
# NUNCA prefixar com VITE_. NUNCA expor no cliente.
# --------------------------------------------------------------------------
GEMINI_API_KEY="sua-gemini-api-key-SECRETA"
# Opcional — modelo do Gemini. Padrão no código: gemini-2.0-flash
GEMINI_MODEL="gemini-2.0-flash"

# --------------------------------------------------------------------------
# Kiwify — webhook de compra (SERVIDOR)
# --------------------------------------------------------------------------
# Token secreto exigido pelo webhook (?token=... ou header x-kiwify-token).
# Sem ele, o webhook responde 503 (desabilitado).
KIWIFY_WEBHOOK_TOKEN="defina-um-token-secreto-forte"
# URL pública do site para os links de recuperação/acesso.
# Opcional — se ausente, usa o host da requisição.
SITE_URL="https://www.lytra.shop"

# --------------------------------------------------------------------------
# Resend — envio de e-mail transacional (SERVIDOR)
# RESEND_API_KEY: obter em resend.com/api-keys
# FROM_EMAIL: endereço verificado no Resend, ex: "Lytra <acesso@lytra.shop>"
# --------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="Lytra <acesso@lytra.shop>"

# --------------------------------------------------------------------------
# Opcional / legado — NÃO é exigido pelo código da aplicação.
# (Mantido apenas por compatibilidade com ferramentas/scripts externos.)
# --------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
SUPABASE_PROJECT_ID="seu-project-ref"
